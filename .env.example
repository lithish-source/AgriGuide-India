# ==========================================================================
# AgriGuide India — Environment Variables
# ==========================================================================
# Copy this file to `.env` (in the same folder as app.py) and fill in your
# values. The .env file is read automatically when you start the app with
# the run script (run.sh / run.bat). If you start manually with `python app.py`,
# export these variables in your shell first OR use a tool like `python-dotenv`.
#
# All variables are OPTIONAL. The app runs fully offline without any of them.
# Setting LLM_API_KEY is what enables the real AI advisor.
# --------------------------------------------------------------------------

# --- LLM / AI Advisor (optional but recommended) -------------------------
# Any OpenAI-compatible chat-completions API works. Pick ONE provider.

# === Option A: OpenAI ===
LLM_API_KEY=sk-your-openai-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === Option B: Groq (free tier, very fast) ===
# LLM_API_KEY=gsk_your-groq-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# === Option C: OpenRouter (access many models with one key) ===
# LLM_API_KEY=sk-or-your-openrouter-key-here
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# === Option D: Together AI ===
# LLM_API_KEY=your-together-key-here
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# === Option E: Local Ollama (no API key needed, runs on your machine) ===
# Install Ollama from https://ollama.com, then `ollama pull llama3.1`
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# === Option F: ZAI (z.ai) ===
# LLM_API_KEY=your-zai-key-here
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL=glm-4-flash

# --- Flask server (optional) ---------------------------------------------
# PORT=5000
# FLASK_DEBUG=0    # set to 1 for auto-reload during development
